---
import { storyblokEditable, renderRichText } from '@storyblok/astro';
import { getBlogCategories, categoryLabel } from '../lib/blogCategories.js';

const { blok, lang = 'de' } = Astro.props;
const bodyHtml = blok.body ? renderRichText(blok.body) : '';
const locale = lang === 'en' ? 'en-GB' : lang === 'es' ? 'es-ES' : 'de-DE';
const date = blok.published_date
  ? new Date(blok.published_date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const categories = await getBlogCategories(lang);
const blogIndex = lang === 'en' ? '/blog/en' : lang === 'es' ? '/blog/es' : '/blog';
---
<article class="article" {...storyblokEditable(blok)}>
  <header>
    {blok.category && <a class="article-cat" href={`${blogIndex}?category=${blok.category}`}>{categoryLabel(categories, blok.category)}</a>}
    <h1>{blok.title}</h1>
    {blok.excerpt && <p class="article-lead">{blok.excerpt}</p>}
    <div class="article-meta">
      {blok.author && <span>{blok.author}</span>}
      {blok.author && date && <span>·</span>}
      {date && <span>{date}</span>}
    </div>
  </header>
  {blok.cover?.filename && (
    <div class="article-cover"><img src={`${blok.cover.filename}/m/1400x0`} alt={blok.cover.alt || blok.title} /></div>
  )}
  {bodyHtml && <div class="article-body" set:html={bodyHtml} />}
</article>
