---
const {
  title = 'Paktum Blog',
  description = '',
  lang = 'de',
  deUrl = '/blog',
  enUrl = '/blog/en',
  esUrl = null,
} = Astro.props;
const SITE = 'https://www.paktum.ch';
const canonicalPath = lang === 'en' ? enUrl : lang === 'es' ? esUrl : deUrl;
const blogIndex = lang === 'en' ? '/blog/en' : lang === 'es' ? '/blog/es' : '/blog';
const ogLocale = lang === 'en' ? 'en_US' : lang === 'es' ? 'es_ES' : 'de_DE';
const langCode = lang === 'en' ? 'EN' : lang === 'es' ? 'ES' : 'DE';

// Navbar: mismo contenido que el de paktum.ch (Paktum-landing), por idioma
const NAV: Record<'de' | 'en' | 'es', { home: string; product: string; features: string; value: string; references: string; pricing: string; about: string; cta: string; allFeatures: string; items: [string, string, string][] }> = {
  de: {
    home: '/', product: 'Produkt', features: 'Funktionen', value: 'Mehrwerte', references: 'Referenzen',
    pricing: 'Preise', about: 'Über uns', cta: 'Demo buchen', allFeatures: 'Alle Funktionen ansehen',
    items: [
      ['home', 'Home', 'Alles Wichtige auf einen Blick'],
      ['product-catalog', 'Produktkatalog', 'Rechte, Inventar und Kontingente'],
      ['position-editor', 'Position Editor', 'Stadionplan und Werbepositionen'],
      ['partner-crm', 'Partner-CRM', 'Pipeline, Partnerprofil und Kommunikation'],
      ['contracts', 'Verträge', 'Konditionen, Dokumente und Sachleistungen'],
      ['activation', 'Umsetzung', 'Umsetzungsaufgaben und Kalender'],
      ['led-planner', 'LED-Planung', 'Playlists aus gebuchten Sequenzen'],
      ['invoicing', 'Rechnungen', 'Automatische Rechnungsstellung und Controlling'],
      ['analytics', 'Analytics', 'Finanzen, Cashflow und Auslastung'],
    ],
  },
  en: {
    home: '/en', product: 'Product', features: 'Features', value: 'Value', references: 'References',
    pricing: 'Pricing', about: 'About Us', cta: 'Book a demo', allFeatures: 'See all features',
    items: [
      ['home', 'Home', 'Everything that matters at a glance'],
      ['product-catalog', 'Product Catalog', 'Rights, inventory and quotas'],
      ['position-editor', 'Position Editor', 'Stadium plan and advertising positions'],
      ['partner-crm', 'Partner CRM', 'Pipeline, partner records and communication'],
      ['contracts', 'Contracts', 'Conditions, documents and in-kind benefits'],
      ['activation', 'Activation', 'Implementation tasks and calendar'],
      ['led-planner', 'LED Planning', 'Playlists from booked sequences'],
      ['invoicing', 'Invoicing', 'Automatic invoicing and controlling'],
      ['analytics', 'Analytics', 'Finances, cash flow and utilization'],
    ],
  },
  es: {
    home: '/es', product: 'Producto', features: 'Funciones', value: 'Valor', references: 'Referencias',
    pricing: 'Precios', about: 'Nosotros', cta: 'Reservar una demo', allFeatures: 'Ver todas las funciones',
    items: [
      ['home', 'Home', 'Todo lo importante de un vistazo'],
      ['product-catalog', 'Catálogo', 'Derechos, inventario y cupos'],
      ['position-editor', 'Position Editor', 'Plano del estadio y posiciones publicitarias'],
      ['partner-crm', 'CRM de partners', 'Pipeline, ficha de partner y comunicación'],
      ['contracts', 'Contratos', 'Condiciones, documentos y prestaciones en especie'],
      ['activation', 'Ejecución', 'Tareas de ejecución y calendario'],
      ['led-planner', 'Planificación LED', 'Playlists a partir de secuencias reservadas'],
      ['invoicing', 'Facturación', 'Facturación automática y controlling'],
      ['analytics', 'Analítica', 'Finanzas, cash flow y ocupación'],
    ],
  },
};
const nav = NAV[lang === 'en' ? 'en' : lang === 'es' ? 'es' : 'de'];
const prefix = lang === 'en' ? '/en' : lang === 'es' ? '/es' : '';
const homeUrl = SITE + nav.home;
const featuresUrl = SITE + prefix + '/features';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://www.paktum.ch/favicon.svg" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={SITE + canonicalPath} />
    <link rel="alternate" hreflang="de" href={SITE + deUrl} />
    {enUrl && <link rel="alternate" hreflang="en" href={SITE + enUrl} />}
    {esUrl && <link rel="alternate" hreflang="es" href={SITE + esUrl} />}
    <link rel="alternate" hreflang="x-default" href={SITE + deUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE + canonicalPath} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:site_name" content="Paktum" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-image.png`} />

    <script is:inline src="https://web.cmp.usercentrics.eu/modules/autoblocker.js"></script>
    <script is:inline id="usercentrics-cmp" src="https://web.cmp.usercentrics.eu/ui/loader.js" data-settings-id="vroPjhUClfR6mc" async></script>

    <link rel="stylesheet" href="https://use.typekit.net/apb2slf.css" />
    <style is:global>
      :root {
        --color-primary: #970EFB;
        --color-primary-hover: #AD2FFC;
        --color-primary-soft: rgba(151, 14, 251, 0.1);
        --color-bg-base: #F4F2EE;
        --color-bg-surface: #FFFFFF;
        --color-ink: #0A0612;
        --color-ink-soft: #1F0F3D;
        --color-text-primary: #0A0612;
        --color-text-secondary: #635A6F;
        --color-text-muted: #908AA0;
        --color-border: rgba(10, 6, 18, 0.1);
        --font-display: 'forma-djr-text', 'Inter', 'Helvetica Neue', 'Arial', system-ui, sans-serif;
        --container: 1320px;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--font-display); background: var(--color-bg-base); color: var(--color-text-primary); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; line-height: 1.4; overflow-x: hidden; }
      img { max-width: 100%; display: block; }
      .container { max-width: var(--container); margin: 0 auto; padding: 0 32px; }
      .accent { color: var(--color-primary); font-style: italic; }
      .navbar { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); width: calc(100% - 48px); max-width: 1400px; z-index: 100; background: rgba(10, 6, 18, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-radius: 100px; padding: 12px 16px 12px 24px; display: flex; justify-content: space-between; align-items: center; color: white; border: 1px solid rgba(244, 242, 238, 0.12); }
      .nav-logo { display: flex; align-items: center; text-decoration: none; }
      .nav-logo img { height: 28px; width: auto; display: block; }
      .nav-links { display: flex; gap: 32px; list-style: none; }
      .nav-links a { color: #F4F2EE; text-decoration: none; font-size: 14px; font-weight: 500; letter-spacing: 0.04em; opacity: 0.8; transition: opacity 0.2s; }
      .nav-links a:hover, .nav-links a.active { opacity: 1; }
      .nav-links a.active { color: var(--color-primary); }
      .nav-actions { display: flex; align-items: center; gap: 20px; }
      .btn { font-family: 'forma-djr-display', var(--font-display); font-weight: 600; font-size: 15px; padding: 14px 24px; border-radius: 100px; border: none; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px; letter-spacing: 0.01em; text-decoration: none; }
      .btn-primary { background: var(--color-primary); color: #fff; }
      .btn-primary:hover { background: var(--color-primary-hover); }
      .nav-links .nav-dropdown { position: relative; }
      .nav-links .nav-dropdown > a { display: inline-flex; align-items: center; gap: 6px; }
      .nav-caret { width: 10px; height: 10px; opacity: 0.6; transition: transform 0.2s, color 0.2s, opacity 0.2s; }
      .nav-dropdown:hover .nav-caret, .nav-dropdown:focus-within .nav-caret { transform: rotate(180deg); color: var(--color-primary); opacity: 1; }
      /* padding-top cubre el hueco entre el link y el panel para no perder el hover */
      .nav-dropdown-menu { position: absolute; top: 100%; left: 50%; padding-top: 22px; transform: translate(-50%, 6px); opacity: 0; visibility: hidden; transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s; z-index: 200; }
      .nav-dropdown:hover .nav-dropdown-menu, .nav-dropdown:focus-within .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
      .nav-dropdown-panel { width: 600px; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: #15101F; border: 1px solid rgba(244,242,238,0.12); border-radius: 16px; padding: 8px; box-shadow: 0 16px 40px rgba(10,6,18,0.45); }
      .nav-links .nav-dropdown-panel a { opacity: 1; letter-spacing: 0; }
      .nav-dropdown-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px; border-radius: 10px; transition: background 0.15s; }
      .nav-dropdown-item:hover, .nav-dropdown-item:focus-visible { background: rgba(255,255,255,0.06); }
      .nav-dropdown-item .num { font-size: 11px; font-weight: 700; color: var(--color-primary); padding-top: 2px; }
      .nav-dropdown-item b { display: block; font-size: 14px; font-weight: 600; color: #fff; }
      .nav-dropdown-item small { display: block; margin-top: 2px; font-size: 12px; font-weight: 400; line-height: 1.35; color: rgba(244,242,238,0.55); }
      .nav-links .nav-dropdown-all { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; margin-top: 4px; padding: 12px; border-top: 1px solid rgba(244,242,238,0.08); border-radius: 0 0 10px 10px; font-size: 13px; color: var(--color-primary); transition: background 0.15s; }
      .nav-dropdown-all:hover, .nav-dropdown-all:focus-visible { background: rgba(151,14,251,0.12); }
      .hamburger-btn { display: none; background: transparent; border: none; cursor: pointer; padding: 8px; width: 40px; height: 40px; flex-direction: column; justify-content: center; align-items: center; gap: 5px; margin-left: 4px; }
      .hamburger-btn span { width: 22px; height: 2px; background: #fff; border-radius: 2px; transition: all 0.3s ease; display: block; }
      .hamburger-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .hamburger-btn.open span:nth-child(2) { opacity: 0; }
      .hamburger-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      .mobile-menu { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(10, 6, 18, 0.97); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); z-index: 99; padding: 100px 32px 40px; flex-direction: column; overflow-y: auto; }
      .mobile-menu.open { display: flex; }
      .mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: 0; padding: 0; margin: 0; }
      .mobile-menu li { border-bottom: 1px solid rgba(244, 242, 238, 0.1); }
      .mobile-menu li:last-child { border-bottom: none; }
      .mobile-menu a { display: block; color: #fff; text-decoration: none; font-size: 24px; font-weight: 600; letter-spacing: 0.01em; padding: 24px 0; transition: color 0.2s; }
      .mobile-menu a:hover, .mobile-menu a.active { color: var(--color-primary); }
      .mobile-menu-cta { margin-top: 40px; }
      .mobile-menu-cta .btn { width: 100%; justify-content: center; padding: 18px 24px; font-size: 16px; }
      .mobile-menu .mobile-submenu { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; margin: -12px 0 20px; }
      .mobile-menu .mobile-submenu li { border-bottom: none; }
      .mobile-menu .mobile-submenu a { font-size: 15px; font-weight: 500; padding: 9px 0; color: rgba(244,242,238,0.7); }
      .mobile-menu .mobile-submenu .num { font-size: 11px; font-weight: 700; color: var(--color-primary); margin-right: 6px; }
      @media (max-width: 340px) { .mobile-menu .mobile-submenu { grid-template-columns: 1fr; } }
      .site-footer { background: var(--color-bg-base); padding: 80px 16px 32px; margin-top: 96px; }
      .footer-container { max-width: var(--container); margin: 0 auto; }
      .footer-cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 64px; padding-top: 48px; border-top: 1px solid var(--color-border); margin-bottom: 48px; }
      .footer-logo-img { height: 30px; width: auto; margin-bottom: 16px; }
      .footer-brand p { color: var(--color-text-secondary); font-size: 14px; line-height: 1.6; max-width: 360px; }
      .footer-col h5 { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: 16px; }
      .footer-col ul { list-style: none; }
      .footer-col li { margin-bottom: 10px; }
      .footer-col a { color: var(--color-text-primary); text-decoration: none; font-size: 14px; opacity: 0.85; }
      .footer-col a:hover { opacity: 1; color: var(--color-primary); }
      .footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 24px; border-top: 1px solid var(--color-border); font-size: 13px; color: var(--color-text-muted); }
      .swiss-made { height: 36px; width: auto; }
      .blog-hero { padding: 160px 32px 48px; max-width: 900px; }
      .eyebrow { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-primary); margin-bottom: 16px; }
      /* El titulo va siempre en una linea: el tamano se ajusta al ancho disponible (hero de 900px - 64px de padding) */
      .blog-hero h1 { font-size: min(72px, calc((100vw - 64px) / 12)); font-weight: 700; line-height: 1; letter-spacing: -0.01em; white-space: nowrap; }
      .blog-hero .lead { margin-top: 24px; font-size: 19px; line-height: 1.5; color: var(--color-text-secondary); max-width: 560px; }
      .cat-filter { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
      .cat-chip { font-size: 14px; font-weight: 600; color: var(--color-text-secondary); background: var(--color-bg-surface); border: 1px solid var(--color-border); padding: 9px 18px; border-radius: 100px; text-decoration: none; transition: color 0.2s, background 0.2s, border-color 0.2s; }
      .cat-chip:hover { color: var(--color-ink); border-color: rgba(10, 6, 18, 0.25); }
      .cat-chip.active { color: #fff; background: var(--color-ink); border-color: var(--color-ink); }
      .post-card[hidden] { display: none; }
      .pager { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 8px; padding-bottom: 40px; }
      .pager[hidden] { display: none; }
      .pager a { min-width: 44px; height: 44px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; border-radius: 100px; border: 1px solid var(--color-border); background: var(--color-bg-surface); color: var(--color-text-secondary); font-size: 14px; font-weight: 600; text-decoration: none; transition: color 0.2s, background 0.2s, border-color 0.2s; }
      .pager a:hover { color: var(--color-ink); border-color: rgba(10, 6, 18, 0.25); }
      .pager a.active { color: #fff; background: var(--color-ink); border-color: var(--color-ink); }
      .pager a[aria-disabled] { opacity: 0.35; pointer-events: none; }
      .pager .gap { color: var(--color-text-muted); padding: 0 4px; }
      .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding-bottom: 40px; }
      .post-card { display: flex; flex-direction: column; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.25s ease, box-shadow 0.25s ease; }
      .post-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(10, 6, 18, 0.10); }
      .post-card-media { aspect-ratio: 16 / 9; background: var(--color-bg-base); overflow: hidden; }
      .post-card-media img { width: 100%; height: 100%; object-fit: cover; }
      .post-card-body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
      .post-card-cat { align-self: flex-start; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); background: var(--color-primary-soft); padding: 4px 10px; border-radius: 100px; }
      .post-card h2 { font-size: 19px; font-weight: 700; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .post-card-body p { font-size: 14px; line-height: 1.5; color: var(--color-text-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .post-card-meta { margin-top: auto; padding-top: 4px; font-size: 13px; color: var(--color-text-muted); }
      .article { max-width: 720px; margin: 0 auto; padding: 150px 32px 0; }
      .article-cat { display: inline-block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); background: var(--color-primary-soft); padding: 5px 12px; border-radius: 100px; margin-bottom: 20px; text-decoration: none; }
      .article h1 { font-size: clamp(34px, 5vw, 54px); font-weight: 700; line-height: 1.08; letter-spacing: -0.01em; }
      .article-lead { margin-top: 20px; font-size: 20px; line-height: 1.5; color: var(--color-text-secondary); }
      .article-meta { margin-top: 24px; display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--color-text-muted); }
      .article-cover { margin: 40px 0; border-radius: 20px; overflow: hidden; }
      .article-cover img { width: 100%; height: auto; }
      .article-body { font-size: 18px; line-height: 1.75; color: var(--color-text-primary); padding-bottom: 24px; }
      .article-body h2 { font-size: 30px; font-weight: 700; line-height: 1.2; margin: 48px 0 16px; letter-spacing: -0.01em; }
      .article-body h3 { font-size: 23px; font-weight: 700; line-height: 1.25; margin: 36px 0 12px; }
      .article-body p { margin: 0 0 24px; }
      .article-body a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
      .article-body ul, .article-body ol { margin: 0 0 24px 24px; }
      .article-body li { margin-bottom: 8px; }
      .article-body img { width: 100%; border-radius: 16px; margin: 32px 0; }
      .article-body blockquote { margin: 32px 0; padding: 8px 0 8px 24px; border-left: 3px solid var(--color-primary); font-size: 21px; line-height: 1.5; color: var(--color-ink-soft); font-style: italic; }
      .article-foot { max-width: 720px; margin: 0 auto; padding: 32px; margin-bottom: 48px; }
      .back-link { color: var(--color-primary); text-decoration: none; font-weight: 600; font-size: 15px; }
      .back-link:hover { text-decoration: underline; }
      @media (max-width: 980px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 640px) { .navbar { top: 12px; width: calc(100% - 24px); padding: 8px 8px 8px 16px; } .navbar .btn-primary { font-size: 12px; padding: 9px 14px; } .nav-logo img { height: 24px; } .nav-actions { gap: 12px; } }
      @media (max-width: 720px) { .footer-cols { grid-template-columns: 1fr; gap: 40px; } }
      @media (max-width: 640px) { .blog-grid { grid-template-columns: 1fr; } .blog-hero { padding-top: 130px; } .article { padding-top: 120px; } .article-body { font-size: 17px; } }

      .nav-lang { position: relative; display: flex; align-items: center; gap: 0; }
      .lang-trigger { display: inline-flex; align-items: center; gap: 6px; background: transparent; border: none; cursor: pointer; color: rgba(244,242,238,0.7); font-family: inherit; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 8px; border-radius: 100px; transition: color 0.2s; }
      .lang-trigger:hover { color: #fff; }
      .lang-trigger .lang-globe { width: 15px; height: 15px; opacity: 0.7; flex-shrink: 0; }
      .lang-trigger .lang-caret { width: 9px; height: 9px; opacity: 0.6; flex-shrink: 0; transition: transform 0.2s, color 0.2s; }
      .nav-lang.open .lang-trigger .lang-caret, .lang-floating.open .lang-trigger .lang-caret { transform: rotate(180deg); color: var(--color-primary); opacity: 1; }
      .lang-menu { position: absolute; top: calc(100% + 8px); right: 0; min-width: 140px; background: #15101F; border: 1px solid rgba(244,242,238,0.12); border-radius: 12px; padding: 4px; display: none; flex-direction: column; box-shadow: 0 12px 32px rgba(10,6,18,0.4); z-index: 200; }
      .nav-lang.open .lang-menu, .lang-floating.open .lang-menu { display: flex; }
      .lang-menu .lang-btn { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 12px; border-radius: 8px; color: rgba(244,242,238,0.7); text-decoration: none; font-family: inherit; font-size: 13px; font-weight: 400; letter-spacing: 0; text-transform: none; transition: background 0.15s, color 0.15s; }
      .lang-menu .lang-btn:hover { background: rgba(255,255,255,0.06); color: #fff; }
      .lang-menu .lang-btn.active { color: var(--color-primary); font-weight: 500; background: rgba(151,14,251,0.12); }
      .lang-menu .lang-check { width: 14px; height: 14px; opacity: 0; flex-shrink: 0; }
      .lang-menu .lang-btn.active .lang-check { opacity: 1; }
      .lang-floating { position: fixed; bottom: 16px; right: 16px; z-index: 101; display: none; padding: 0; background: transparent; border: none; box-shadow: none; }
      .lang-floating .lang-trigger { background: rgba(10,6,18,0.92); border: 1px solid rgba(244,242,238,0.15); box-shadow: 0 8px 24px rgba(10,6,18,0.25); padding: 8px 14px; }
      .lang-floating .lang-menu { top: auto; bottom: calc(100% + 8px); right: 0; }
      body.menu-open .lang-floating { display: none; }
      /* Igual que paktum.ch: por debajo de ~1100px el navbar completo no cabe, se pasa al menu hamburguesa */
      @media (max-width: 1280px) { .nav-links { gap: 24px; } }
      @media (max-width: 1100px) {
        .nav-links { display: none; }
        .nav-actions .nav-lang { display: none !important; }
        .nav-actions .btn-primary { display: none; }
        .hamburger-btn { display: flex; }
        .lang-floating { display: flex; }
        body.menu-open .lang-floating { display: none; }
        body.menu-open { overflow: hidden; }
      }
    
      /* Blog: tablas de los articulos */
      .article-body table { width: 100%; border-collapse: collapse; margin: 36px 0; font-size: 16px; line-height: 1.55; display: block; overflow-x: auto; }
      .article-body th, .article-body td { padding: 12px 18px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-border); }
      .article-body th { font-weight: 700; color: var(--color-ink); vertical-align: bottom; border-bottom: 2px solid var(--color-ink); }
      .article-body td:first-child { font-weight: 600; color: var(--color-ink); }
      .article-body table tr:nth-child(even) td { background: rgba(10, 6, 18, 0.02); }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href={homeUrl} class="nav-logo"><img src="https://www.paktum.ch/SVG%20Logos/Recurso%206.svg" alt="Paktum" /></a>
      <ul class="nav-links">
        <li><a href={`${SITE}${prefix}#product`}>{nav.product}</a></li>
        <li class="nav-dropdown">
          <a href={`${SITE}${prefix}#features`} aria-haspopup="true">{nav.features}<svg class="nav-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
          <div class="nav-dropdown-menu">
            <div class="nav-dropdown-panel">
              {nav.items.map(([id, name, desc], i) => (
                <a class="nav-dropdown-item" href={`${featuresUrl}#${id}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><span><b>{name}</b><small>{desc}</small></span></a>
              ))}
              <a class="nav-dropdown-all" href={featuresUrl}>{nav.allFeatures}<span aria-hidden="true">→</span></a>
            </div>
          </div>
        </li>
        <li><a href={`${SITE}${prefix}#stats`}>{nav.value}</a></li>
        <li><a href={`${SITE}${prefix}/references`}>{nav.references}</a></li>
        <li><a href={`${SITE}${prefix}/pricing`}>{nav.pricing}</a></li>
        <li><a href={`${SITE}${prefix}/about`}>{nav.about}</a></li>
        <li><a href={blogIndex} class="active">Blog</a></li>
      </ul>
      <div class="nav-actions">
        <div class="nav-lang">
          <button type="button" class="lang-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Sprache waehlen"><svg class="lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 16 0 18M12 3c-2.5 2.5-2.5 16 0 18"/></svg><span class="lang-current">{langCode}</span><svg class="lang-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button>
          <div class="lang-menu">
            <a href={deUrl} class={lang === 'de' ? 'lang-btn active' : 'lang-btn'}><span>Deutsch</span><svg class="lang-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg></a>
            <a href={enUrl ? enUrl : '/blog/en'} class={lang === 'en' ? 'lang-btn active' : 'lang-btn'}><span>English</span><svg class="lang-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg></a>
            <a href={esUrl ? esUrl : '/blog/es'} class={lang === 'es' ? 'lang-btn active' : 'lang-btn'}><span>Español</span><svg class="lang-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg></a>
          </div>
        </div>
        <a href={`${SITE}${prefix}/book-a-demo`} class="btn btn-primary">{nav.cta}</a>
        <button class="hamburger-btn" id="hamburger" aria-label="Toggle menu" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </nav>
    <div class="mobile-menu" id="mobileMenu">
      <ul>
        <li><a href={homeUrl}>{nav.product}</a></li>
        <li><a href={`${SITE}${prefix}#features`}>{nav.features}</a>
          <ul class="mobile-submenu">
            {nav.items.map(([id, name], i) => (
              <li><a href={`${featuresUrl}#${id}`}><span class="num">{String(i + 1).padStart(2, '0')}</span>{name}</a></li>
            ))}
          </ul>
        </li>
        <li><a href={`${SITE}${prefix}#stats`}>{nav.value}</a></li>
        <li><a href={`${SITE}${prefix}/references`}>{nav.references}</a></li>
        <li><a href={`${SITE}${prefix}/pricing`}>{nav.pricing}</a></li>
        <li><a href={`${SITE}${prefix}/about`}>{nav.about}</a></li>
        <li><a href={blogIndex} class="active">Blog</a></li>
      </ul>
      <div class="mobile-menu-cta">
        <a href={`${SITE}${prefix}/book-a-demo`} class="btn btn-primary">{nav.cta}</a>
      </div>
    </div>
    <div class="lang-floating">
      <button type="button" class="lang-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Sprache waehlen"><svg class="lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 16 0 18M12 3c-2.5 2.5-2.5 16 0 18"/></svg><span class="lang-current">{langCode}</span><svg class="lang-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button>
      <div class="lang-menu">
            <a href={deUrl} class={lang === 'de' ? 'lang-btn active' : 'lang-btn'}><span>Deutsch</span><svg class="lang-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg></a>
            <a href={enUrl ? enUrl : '/blog/en'} class={lang === 'en' ? 'lang-btn active' : 'lang-btn'}><span>English</span><svg class="lang-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg></a>
            <a href={esUrl ? esUrl : '/blog/es'} class={lang === 'es' ? 'lang-btn active' : 'lang-btn'}><span>Español</span><svg class="lang-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7"/></svg></a>
      </div>
    </div>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-cols">
          <div class="footer-brand">
            <img class="footer-logo-img" src="https://www.paktum.ch/SVG%20Logos/Recurso%205.svg" alt="Paktum" />
            <p>Das Schweizer Taschenmesser für dein Sponsoring. Ein Produkt der KLTechnologies GmbH, mit Sitz in Luzern, Schweiz.</p>
          </div>
          <div class="footer-col">
            <h5>Product</h5>
            <ul>
              <li><a href="https://www.paktum.ch/#features">Features</a></li>
              <li><a href="https://www.paktum.ch/pricing">Pricing</a></li>
              <li><a href={blogIndex}>Blog</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h5>Legal</h5>
            <ul><li><a href="https://www.paktum.ch/impressum">Imprint</a></li></ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 KLTechnologies GmbH</span>
          <img class="swiss-made" src="https://www.paktum.ch/SVG%20Logos/Swiss_Made.svg" alt="Swiss Made" />
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var hb = document.getElementById('hamburger');
        var mm = document.getElementById('mobileMenu');
        if (hb && mm) {
          var toggleMenu = function () {
            var open = mm.classList.toggle('open');
            hb.classList.toggle('open', open);
            document.body.classList.toggle('menu-open', open);
            hb.setAttribute('aria-expanded', open ? 'true' : 'false');
          };
          hb.addEventListener('click', toggleMenu);
          mm.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () { if (mm.classList.contains('open')) toggleMenu(); });
          });
        }
        document.querySelectorAll('.lang-trigger').forEach(function(trigger){
          trigger.addEventListener('click', function(e){
            e.preventDefault(); e.stopPropagation();
            var container = trigger.closest('.nav-lang, .lang-floating');
            var willOpen = !container.classList.contains('open');
            document.querySelectorAll('.nav-lang, .lang-floating').forEach(function(c){ c.classList.remove('open'); });
            document.querySelectorAll('.lang-trigger').forEach(function(t){ t.setAttribute('aria-expanded','false'); });
            if (willOpen) { container.classList.add('open'); trigger.setAttribute('aria-expanded','true'); }
          });
        });
        document.addEventListener('click', function(){
          document.querySelectorAll('.nav-lang, .lang-floating').forEach(function(c){ c.classList.remove('open'); });
          document.querySelectorAll('.lang-trigger').forEach(function(t){ t.setAttribute('aria-expanded','false'); });
        });
      })();
    </script>
  </body>
</html>
